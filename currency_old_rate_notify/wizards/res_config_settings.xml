<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="main_currency" position="after">
                <setting
                    id="currency_old_rate_notify_days"
                    string="Warn when currency rates are too old"
                    help="Define the number of days"
                >
                    <field name="currency_old_rate_notify_days" />
                </setting>
            </setting>
        </field>
    </record>
</odoo>
