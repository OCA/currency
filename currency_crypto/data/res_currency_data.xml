<odoo>
    <data noupdate="1">
        <record id="USDT" model="res.currency">
            <field name="name">USDT</field>
            <field name="full_name">Tether (USDT) </field>
            <field name="symbol">USDT</field>
            <field name="rounding">0.01</field>
            <field name="position">after</field>
            <field name="active" eval="False" />
            <field name="currency_unit_label">USDT</field>
            <field name="currency_subunit_label">Cents</field>
        </record>

        <record id="USDC" model="res.currency">
            <field name="name">USDC</field>
            <field name="full_name">USD Coin</field>
            <field name="symbol">USDC</field>
            <field name="rounding">0.01</field>
            <field name="position">after</field>
            <field name="active" eval="False" />
            <field name="currency_unit_label">USDC</field>
            <field name="currency_subunit_label">Cents</field>
        </record>
    </data>
</odoo>
