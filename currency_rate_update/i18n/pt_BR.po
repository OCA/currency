#. module: currency_rate_update
#: model_terms:ir.ui.view,arch_db:currency_rate_update.res_currency_rate_provider_form_view
msgid ""
"<strong>!</strong>\n"
"                                You are using European Central Bank exchange "
"rate\n"
"                                service with a base currency different from "
"EUR.\n"
"                                <br/>\n"
"                                As long as the European Central Bank only "
"provides\n"
"                                exchange rates based on EUR, other foreign "
"currency\n"
"                                rates are recalculated and might differ from "
"real rates."
msgstr ""
"<strong>!</strong>\n"
"                                Você está usando o serviço de cotações do "
"Banco Central Europeu\n"
"                                com uma moeda base diferente de EUR.\n"
"                                <br/>\n"
"                                Como o Banco Central Europeu só fornece\n"
"                                cotações com base em EUR, as cotações das "
"demais moedas\n"
"                                são recalculadas e podem diferir das "
"cotações reais."

