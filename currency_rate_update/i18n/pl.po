#. module: currency_rate_update
#: model_terms:ir.ui.view,arch_db:currency_rate_update.res_currency_rate_provider_form_view
msgid ""
"<strong>!</strong>\n"
"                                You are using European Central Bank exchange "
"rate\n"
"                                service with a base currency different from "
"EUR.\n"
"                                <br/>\n"
"                                As long as the European Central Bank only "
"provides\n"
"                                exchange rates based on EUR, other foreign "
"currency\n"
"                                rates are recalculated and might differ from "
"real rates."
msgstr ""
"<strong>!</strong>\n"
"                                Korzystasz z usługi kursów walut "
"Europejskiego Banku Centralnego\n"
"                                z walutą bazową inną niż EUR.\n"
"                                <br/>\n"
"                                Europejski Bank Centralny publikuje "
"wyłącznie kursy\n"
"                                względem EUR, dlatego kursy pozostałych "
"walut są\n"
"                                przeliczane i mogą różnić się od "
"rzeczywistych."

